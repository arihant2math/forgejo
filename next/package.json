{
  "name": "forgejo-next",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.node.json",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "oxlint --type-aware --tsconfig lint/tsconfig.json --deny-warnings --report-unused-disable-directives",
    "lint:css": "stylelint --max-warnings=0 \"src/**/*.css\" --ignore-pattern \"src/test/lint-fixtures/**\"",
    "test": "vitest run --project 'unit*'",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:conformance": "vitest run --config conformance/vitest.config.ts",
    "test:browser": "playwright test",
    "budget": "node tools/budget.ts",
    "check:cheap": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "check": "pnpm run check:cheap && pnpm test && pnpm run budget"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@lezer/highlight": "1.2.4",
    "@lezer/lr": "1.4.10",
    "@lezer/markdown": "1.7.2",
    "@pierre/diffs": "1.5.2",
    "@pierre/highlights": "0.1.3",
    "@primer/css": "22.3.2",
    "@primer/octicons-react": "19.40.0",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.40.1",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-virtual": "3.14.13",
    "clsx": "2.1.1",
    "comlink": "4.4.2",
    "minisearch": "7.2.0",
    "mobx": "7.0.4",
    "mobx-react-lite": "5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-virtuoso": "4.18.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/estree": "1.0.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-is": "19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "lightningcss": "1.33.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
