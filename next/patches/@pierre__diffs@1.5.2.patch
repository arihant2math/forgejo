diff --git a/dist/utils/trustedHTML.js b/dist/utils/trustedHTML.js
new file mode 100644
index 0000000000000000000000000000000000000000..121be551a5b0367952ec262f248e7294dc3fc31f
--- /dev/null
+++ b/dist/utils/trustedHTML.js
@@ -0,0 +1,11 @@
+//#region src/utils/trustedHTML.ts
+let createHTML;
+/** Every HTML string the components write to the DOM (their own hast-util-to-html output and sprite) goes through `create`, e.g. a Trusted Types policy's createHTML. */
+function setTrustedHTML(create) {
+	createHTML = create;
+}
+function trustedHTML(html) {
+	return createHTML == null ? html : createHTML(html);
+}
+//#endregion
+export { setTrustedHTML, trustedHTML };
